{
  "$comment": "Single source of truth for Saqme's look on phone and desktop. After editing, run: node scripts/build-tokens.mjs (writes worker/public/css/tokens.css and desktop/tokens.ps1). See docs/design.md.",
  "font": {
    "family": "FiraGO",
    "files": [
      { "file": "FiraGO-Regular.ttf", "weight": 400, "style": "normal" },
      { "file": "FiraGO-Italic.ttf", "weight": 400, "style": "italic" },
      { "file": "FiraGO-Medium.ttf", "weight": 500, "style": "normal" },
      { "file": "FiraGO-SemiBold.ttf", "weight": 600, "style": "normal" }
    ],
    "webFallback": "system-ui, -apple-system, 'Segoe UI', 'Noto Sans Georgian', sans-serif",
    "desktopFallback": "Segoe UI Variable Text, Segoe UI"
  },
  "type": {
    "display": { "size": 22, "line": 28, "weight": 600 },
    "title": { "size": 18, "line": 24, "weight": 600 },
    "body": { "size": 15, "line": 22, "weight": 400 },
    "label": { "size": 14, "line": 20, "weight": 500 },
    "meta": { "size": 13, "line": 18, "weight": 400 },
    "small": { "size": 12, "line": 16, "weight": 500 }
  },
  "space": [2, 4, 8, 12, 16, 24, 32],
  "radius": { "container": 14, "card": 12, "tab": 10, "control": 7, "chip": 5 },
  "row": { "minTouch": 48, "minPointer": 40, "indent": 20, "chipGap": 12, "metaGap": 2 },
  "card": { "inset": 12, "padding": 14, "gap": 20, "rowMin": 44 },
  "gradient": ["#B65CE3", "#F3A14A"],
  "themes": {
    "dark": {
      "named": { "surface": "#1E1A23", "frame": "#15121A", "ink": "#EFEAF4", "smoke": "#A39BAE", "violet": "#C688EE", "amber": "#F2B45A" },
      "alert": "#F2877F",
      "closed": "#8F8799",
      "wash": 0.16,
      "card": { "toward": "ink", "amount": 0.035, "selected": 0.10 },
      "status": { "todo": "#7C7589", "prog": "#E8A23A", "done": "#7E758C", "post": "#4F86C6", "block": "#776BCB", "rej": "#D94B45", "aband": "#7D748A" }
    },
    "light": {
      "named": { "surface": "#F6F2EA", "frame": "#E9E2D4", "ink": "#25211C", "smoke": "#675F52", "violet": "#8930B6", "amber": "#7F5100" },
      "alert": "#A62B25",
      "closed": "#6F685B",
      "wash": 0.13,
      "card": { "toward": "#FFFFFF", "amount": 0.75, "selected": 0.14 },
      "status": { "todo": "#827A69", "prog": "#A86E16", "done": "#847A65", "post": "#427DC2", "block": "#6E62C8", "rej": "#D94943", "aband": "#7F788B" }
    }
  }
}
