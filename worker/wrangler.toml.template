# Generated by scripts/cloud-setup.mjs from worker/wrangler.toml.template - edit the template, not this file.
name = "__WORKER_NAME__"
main = "src/index.js"
compatibility_date = "2026-10-01"
account_id = "__ACCOUNT_ID__"
workers_dev = true

# the PWA; only /api/* reaches the Worker code (static files are served for free)
[assets]
directory = "./public"
binding = "ASSETS"
run_worker_first = ["/api/*"]

[[d1_databases]]
binding = "DB"
database_name = "__DATABASE_NAME__"
database_id = "__DATABASE_ID__"
migrations_dir = "migrations"

# reminder pushes: every 5 minutes (288 runs a day, far inside the free plan)
[triggers]
crons = ["*/5 * * * *"]
