{
  "about": [
    "The lists-folder sync engine, which exists twice: desktop/sync-core.ps1 (Windows) and local/engine.mjs (Linux, macOS).",
    "Rows: {\"p\": project id, name, pos, deleted?} and {\"t\": task id, \"in\": project id, pos, text, parent?, status?, due?, notes?,",
    "deleted?}. lists: the files in the lists folder (\".trash/...\" inside lists/.trash; \"busy\": written a moment ago). files:",
    "project id -> file name. plan: with the base S (what the files reflect) and the server rows R, build the plan that makes",
    "the files match R and apply it; after = every file in the folder afterwards (lists/.trash aside: \"trash\" lists the start",
    "of each file name there). diff: with base S (ts 100), read the folder and queue changes; changes = [kind, id, field,",
    "value, {base?, ts?}?] (any order; base / ts checked when given), with \"guarded\" (deletes held back) and \"skipped\" (some",
    "list was not usable, or one is briefly missing) when given. State before the diff: \"missing\" (project id -> seconds its",
    "list has been missing), \"planned\" (task id -> {age: seconds since the plan, added?, addedTs?, fields: {field: [value",
    "before the plan, its ts]}}), \"guard\" (keys held back last time) and \"allow\" (the user confirmed them); \"guardAfter\":",
    "the keys held back afterwards."
  ],
  "plan": [
    {
      "name": "edits from another device land in place; headings and prose stay",
      "lists": { "Work.md": "# Work\n- [ ] A ^aaaaaaaa\n- [ ] B ^bbbbbbbb\n\nProse stays.\n" },
      "files": { "pwork001": "Work" },
      "S": [
        { "p": "pwork001", "name": "Work", "pos": "a0" },
        { "t": "aaaaaaaa", "in": "pwork001", "pos": "a0", "text": "A" },
        { "t": "bbbbbbbb", "in": "pwork001", "pos": "a1", "text": "B" }
      ],
      "R": [
        { "p": "pwork001", "name": "Work", "pos": "a0" },
        { "t": "aaaaaaaa", "in": "pwork001", "pos": "a0", "text": "A edited", "status": "x" },
        { "t": "bbbbbbbb", "in": "pwork001", "pos": "a1", "text": "B" }
      ],
      "after": { "Work.md": "# Work\n- [x] A edited ^aaaaaaaa\n- [ ] B ^bbbbbbbb\n\nProse stays.\n" }
    },
    {
      "name": "a task deleted elsewhere goes; its subtasks move up a level",
      "lists": { "Work.md": "- [ ] A ^aaaaaaaa\n  - [ ] C ^cccccccc\n- [ ] B ^bbbbbbbb\n" },
      "files": { "pwork001": "Work" },
      "S": [
        { "p": "pwork001", "name": "Work", "pos": "a0" },
        { "t": "aaaaaaaa", "in": "pwork001", "pos": "a0", "text": "A" },
        { "t": "cccccccc", "in": "pwork001", "pos": "a0", "text": "C", "parent": "aaaaaaaa" },
        { "t": "bbbbbbbb", "in": "pwork001", "pos": "a1", "text": "B" }
      ],
      "R": [
        { "p": "pwork001", "name": "Work", "pos": "a0" },
        { "t": "aaaaaaaa", "in": "pwork001", "pos": "a0", "text": "A", "deleted": true },
        { "t": "cccccccc", "in": "pwork001", "pos": "a0", "text": "C", "parent": "aaaaaaaa" },
        { "t": "bbbbbbbb", "in": "pwork001", "pos": "a1", "text": "B" }
      ],
      "after": { "Work.md": "- [ ] C ^cccccccc\n- [ ] B ^bbbbbbbb\n" }
    },
    {
      "name": "a new subtask lands at its position, with its deadline and notes",
      "lists": { "Work.md": "- [ ] A ^aaaaaaaa\n  - [ ] A1 ^aaaaaaa1\n  - [ ] A3 ^aaaaaaa3\n- [ ] B ^bbbbbbbb\n" },
      "files": { "pwork001": "Work" },
      "S": [
        { "p": "pwork001", "name": "Work", "pos": "a0" },
        { "t": "aaaaaaaa", "in": "pwork001", "pos": "a0", "text": "A" },
        { "t": "aaaaaaa1", "in": "pwork001", "pos": "a0", "text": "A1", "parent": "aaaaaaaa" },
        { "t": "aaaaaaa3", "in": "pwork001", "pos": "a2", "text": "A3", "parent": "aaaaaaaa" },
        { "t": "bbbbbbbb", "in": "pwork001", "pos": "a1", "text": "B" }
      ],
      "R": [
        { "p": "pwork001", "name": "Work", "pos": "a0" },
        { "t": "aaaaaaaa", "in": "pwork001", "pos": "a0", "text": "A" },
        { "t": "aaaaaaa1", "in": "pwork001", "pos": "a0", "text": "A1", "parent": "aaaaaaaa" },
        { "t": "aaaaaaa3", "in": "pwork001", "pos": "a2", "text": "A3", "parent": "aaaaaaaa" },
        { "t": "bbbbbbbb", "in": "pwork001", "pos": "a1", "text": "B" },
        {
          "t": "aaaaaaa2",
          "in": "pwork001",
          "pos": "a1",
          "text": "A2",
          "parent": "aaaaaaaa",
          "status": "/",
          "due": { "date": "2026-10-25", "time": "9:30" },
          "notes": "see https://x.example"
        }
      ],
      "after": {
        "Work.md": "- [ ] A ^aaaaaaaa\n  - [ ] A1 ^aaaaaaa1\n  - [/] A2 due:2026-10-25T9:30 ^aaaaaaa2\n    > see https://x.example\n  - [ ] A3 ^aaaaaaa3\n- [ ] B ^bbbbbbbb\n"
      }
    },
    {
      "name": "a task moved to another list takes its subtask along",
      "lists": { "Work.md": "- [ ] A ^aaaaaaaa\n  - [ ] A1 ^aaaaaaa1\n- [ ] B ^bbbbbbbb\n", "Home.md": "- [ ] H ^hhhhhhhh\n" },
      "files": { "pwork001": "Work", "phome001": "Home" },
      "S": [
        { "p": "pwork001", "name": "Work", "pos": "a0" },
        { "p": "phome001", "name": "Home", "pos": "a1" },
        { "t": "aaaaaaaa", "in": "pwork001", "pos": "a0", "text": "A" },
        { "t": "aaaaaaa1", "in": "pwork001", "pos": "a0", "text": "A1", "parent": "aaaaaaaa" },
        { "t": "bbbbbbbb", "in": "pwork001", "pos": "a1", "text": "B" },
        { "t": "hhhhhhhh", "in": "phome001", "pos": "a0", "text": "H" }
      ],
      "R": [
