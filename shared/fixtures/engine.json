      "name": "a CRLF file is read like any other",
      "lists": { "Work.md": "- [x] A ^aaaaaaaa\r\n  > two\r\n  > lines\r\n" },
      "files": { "pwork001": "Work" },
      "S": [{ "p": "pwork001", "name": "Work", "pos": "a0" }, { "t": "aaaaaaaa", "in": "pwork001", "pos": "a0", "text": "A" }],
