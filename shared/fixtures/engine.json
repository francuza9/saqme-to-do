      "files": { "pwork001": "Work", "pold0001": "Old" },
      "S": [
        { "p": "pwork001", "name": "Work", "pos": "a0" },
        { "p": "pold0001", "name": "Old", "pos": "a1" },
        { "t": "aaaaaaaa", "in": "pwork001", "pos": "a0", "text": "A" },
        { "t": "oooooooo", "in": "pold0001", "pos": "a0", "text": "O" }
      ],
      "R": [
