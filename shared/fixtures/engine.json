        { "p": "phome001", "name": "Home", "pos": "a1" },
        { "t": "aaaaaaaa", "in": "phome001", "pos": "a1", "text": "A" },
        { "t": "aaaaaaa1", "in": "phome001", "pos": "a0", "text": "A1", "parent": "aaaaaaaa" },
        { "t": "bbbbbbbb", "in": "pwork001", "pos": "a1", "text": "B" },
        { "t": "hhhhhhhh", "in": "phome001", "pos": "a0", "text": "H" }
      ],
      "after": { "Work.md": "- [ ] B ^bbbbbbbb\n", "Home.md": "- [ ] H ^hhhhhhhh\n- [ ] A ^aaaaaaaa\n  - [ ] A1 ^aaaaaaa1\n" }
    },
    {
      "name": "siblings reordered elsewhere",
      "lists": { "Work.md": "- [ ] A ^aaaaaaaa\n- [ ] B ^bbbbbbbb\n- [ ] C ^cccccccc\n" },
      "files": { "pwork001": "Work" },
      "S": [
        { "p": "pwork001", "name": "Work", "pos": "a0" },
        { "t": "aaaaaaaa", "in": "pwork001", "pos": "a0", "text": "A" },
        { "t": "bbbbbbbb", "in": "pwork001", "pos": "a1", "text": "B" },
        { "t": "cccccccc", "in": "pwork001", "pos": "a2", "text": "C" }
      ],
      "R": [
        { "p": "pwork001", "name": "Work", "pos": "a0" },
        { "t": "aaaaaaaa", "in": "pwork001", "pos": "a0", "text": "A" },
        { "t": "bbbbbbbb", "in": "pwork001", "pos": "a1", "text": "B" },
        { "t": "cccccccc", "in": "pwork001", "pos": "Zz", "text": "C" }
      ],
      "after": { "Work.md": "- [ ] C ^cccccccc\n- [ ] A ^aaaaaaaa\n- [ ] B ^bbbbbbbb\n" }
    },
    {
      "name": "a list renamed elsewhere: the file is renamed",
      "lists": { "Home.md": "- [ ] H ^hhhhhhhh\n" },
      "files": { "phome001": "Home" },
      "S": [{ "p": "phome001", "name": "Home", "pos": "a0" }, { "t": "hhhhhhhh", "in": "phome001", "pos": "a0", "text": "H" }],
      "R": [{ "p": "phome001", "name": "House", "pos": "a0" }, { "t": "hhhhhhhh", "in": "phome001", "pos": "a0", "text": "H" }],
      "after": { "House.md": "- [ ] H ^hhhhhhhh\n", ".order": "House\n" },
      "filesAfter": { "phome001": "House" }
    },
    {
      "name": "a list renamed only in letter case: the same file gets the new name, not a copy \"Work (2)\"",
      "lists": { "work.md": "- [ ] A ^aaaaaaaa\n" },
      "files": { "pwork001": "work" },
      "S": [{ "p": "pwork001", "name": "work", "pos": "a0" }, { "t": "aaaaaaaa", "in": "pwork001", "pos": "a0", "text": "A" }],
      "R": [{ "p": "pwork001", "name": "Work", "pos": "a0" }, { "t": "aaaaaaaa", "in": "pwork001", "pos": "a0", "text": "A" }],
      "after": { "Work.md": "- [ ] A ^aaaaaaaa\n", ".order": "Work\n" },
      "filesAfter": { "pwork001": "Work" }
    },
    {
      "name": "a new list from elsewhere becomes a file with its tasks in order",
      "lists": { "Work.md": "- [ ] A ^aaaaaaaa\n" },
      "files": { "pwork001": "Work" },
      "S": [{ "p": "pwork001", "name": "Work", "pos": "a0" }, { "t": "aaaaaaaa", "in": "pwork001", "pos": "a0", "text": "A" }],
      "R": [
        { "p": "pwork001", "name": "Work", "pos": "a0" },
        { "t": "aaaaaaaa", "in": "pwork001", "pos": "a0", "text": "A" },
        { "p": "pgroc001", "name": "Groceries", "pos": "a1" },
        { "t": "gggggg01", "in": "pgroc001", "pos": "a0", "text": "Milk" },
        { "t": "gggggg02", "in": "pgroc001", "pos": "a1", "text": "Bread" },
        { "t": "gggggg03", "in": "pgroc001", "pos": "a0", "text": "Rye", "parent": "gggggg02" }
      ],
      "after": {
