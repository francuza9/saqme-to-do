  ],
  "diff": [
    {
      "name": "edits to text, status, deadline and notes become field changes",
      "lists": { "Work.md": "- [x] A edited due:2026-10-25T9:30 ^aaaaaaaa\n  > a note\n- [ ] B ^bbbbbbbb\n" },
      "files": { "pwork001": "Work" },
      "S": [
        { "p": "pwork001", "name": "Work", "pos": "a0" },
        { "t": "aaaaaaaa", "in": "pwork001", "pos": "a0", "text": "A" },
        { "t": "bbbbbbbb", "in": "pwork001", "pos": "a1", "text": "B" }
      ],
      "changes": [
        ["task", "aaaaaaaa", "text", "A edited"],
        ["task", "aaaaaaaa", "status", "x"],
        ["task", "aaaaaaaa", "due", { "date": "2026-10-25", "time": "9:30" }],
        ["task", "aaaaaaaa", "notes", "a note"]
      ]
    },
    {
