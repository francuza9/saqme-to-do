{
  "about": "Connect Claude Desktop (local/claude-desktop.mjs addServer / removeServer / serverState; desktop/claude-desktop.ps1 Add-ClaudeServer / Remove-ClaudeServer / Get-ClaudeServerState): Saqme's entry in Claude Desktop's claude_desktop_config.json. Each case: before (the file's text, null = no file), op (add | remove | state), then either error: true (the file is left alone), or changed and after (the file afterwards, as JSON: compare parsed, null = no file) plus mcpServers (the server names in their order), or state (none | connected | other). The entry to add is `entry`.",
  "entry": { "command": "/opt/saqme/bin/saqme", "args": ["mcp", "--data", "/home/nuca/Saqme lists"] },
  "cases": [
    { "name": "no file yet: one with just Saqme", "before": null, "op": "add", "changed": true,
      "after": { "mcpServers": { "saqme": { "command": "/opt/saqme/bin/saqme", "args": ["mcp", "--data", "/home/nuca/Saqme lists"] } } }, "mcpServers": ["saqme"] },
    { "name": "an empty file counts as no settings", "before": "  \n", "op": "add", "changed": true,
      "after": { "mcpServers": { "saqme": { "command": "/opt/saqme/bin/saqme", "args": ["mcp", "--data", "/home/nuca/Saqme lists"] } } }, "mcpServers": ["saqme"] },
    { "name": "other servers and settings stay, Saqme comes last",
      "before": "{\n  \"mcpServers\": {\n    \"files\": { \"command\": \"npx\", \"args\": [\"-y\", \"@modelcontextprotocol/server-filesystem\", \"C:\\\\Users\\\\nuca\\\\Docs\"], \"env\": { \"A\": \"1\" } },\n    \"mail\": { \"command\": \"mail-mcp\" }\n  },\n  \"preferences\": { \"quickEntry\": false, \"zoom\": 1.25, \"menu\": null },\n  \"coworkUserFilesPath\": \"D:\\\\Work\"\n}\n",
      "op": "add", "changed": true,
      "after": { "mcpServers": { "files": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:\\Users\\nuca\\Docs"], "env": { "A": "1" } }, "mail": { "command": "mail-mcp" },
                                 "saqme": { "command": "/opt/saqme/bin/saqme", "args": ["mcp", "--data", "/home/nuca/Saqme lists"] } },
                 "preferences": { "quickEntry": false, "zoom": 1.25, "menu": null }, "coworkUserFilesPath": "D:\\Work" },
      "mcpServers": ["files", "mail", "saqme"] },
    { "name": "settings without mcpServers get it", "before": "{\"preferences\":{\"theme\":\"dark\"}}", "op": "add", "changed": true,
      "after": { "preferences": { "theme": "dark" }, "mcpServers": { "saqme": { "command": "/opt/saqme/bin/saqme", "args": ["mcp", "--data", "/home/nuca/Saqme lists"] } } }, "mcpServers": ["saqme"] },
    { "name": "connected already: nothing changes (connecting twice is safe)",
      "before": "{\n    \"mcpServers\": {\n        \"saqme\": {\n            \"command\": \"/opt/saqme/bin/saqme\",\n            \"args\": [\"mcp\", \"--data\", \"/home/nuca/Saqme lists\"]\n        }\n    }\n}\n",
      "op": "add", "changed": false, "after": null, "mcpServers": ["saqme"] },
    { "name": "an older saqme entry (the files server the docs used to suggest) is replaced in its place",
      "before": "{\"mcpServers\":{\"a\":{\"command\":\"a\"},\"saqme\":{\"command\":\"npx\",\"args\":[\"-y\",\"@modelcontextprotocol/server-filesystem\",\"/home/nuca/lists\"]},\"z\":{\"command\":\"z\"}}}",
      "op": "add", "changed": true,
      "after": { "mcpServers": { "a": { "command": "a" }, "saqme": { "command": "/opt/saqme/bin/saqme", "args": ["mcp", "--data", "/home/nuca/Saqme lists"] }, "z": { "command": "z" } } },
      "mcpServers": ["a", "saqme", "z"] },
    { "name": "a byte order mark and letters beyond ASCII are fine",
      "before": "\uFEFF{\"mcpServers\":{\"ფაილები\":{\"command\":\"C:\\\\Program Files\\\\ქ\\\\x.exe\"}},\"note\":\"é <tag> & 'q'\"}", "op": "add", "changed": true,
      "after": { "mcpServers": { "ფაილები": { "command": "C:\\Program Files\\ქ\\x.exe" }, "saqme": { "command": "/opt/saqme/bin/saqme", "args": ["mcp", "--data", "/home/nuca/Saqme lists"] } }, "note": "é <tag> & 'q'" },
      "mcpServers": ["ფაილები", "saqme"] },
    { "name": "not plain JSON (a comment): left alone", "before": "{\n  // my servers\n  \"mcpServers\": {}\n}\n", "op": "add", "error": true },
    { "name": "a trailing comma: left alone", "before": "{\"mcpServers\": {\"a\": {\"command\": \"a\"},}}", "op": "add", "error": true },
    { "name": "not an object: left alone", "before": "[1, 2]", "op": "add", "error": true },
    { "name": "mcpServers that is not an object: left alone", "before": "{\"mcpServers\": [\"saqme\"]}", "op": "add", "error": true },
    { "name": "Disconnect removes Saqme and nothing else",
      "before": "{\"mcpServers\":{\"files\":{\"command\":\"npx\"},\"saqme\":{\"command\":\"/opt/saqme/bin/saqme\",\"args\":[\"mcp\"]},\"mail\":{\"command\":\"m\"}},\"preferences\":{\"x\":true}}",
      "op": "remove", "changed": true,
      "after": { "mcpServers": { "files": { "command": "npx" }, "mail": { "command": "m" } }, "preferences": { "x": true } }, "mcpServers": ["files", "mail"] },
    { "name": "Disconnect of the only server leaves an empty mcpServers", "before": "{\"mcpServers\":{\"saqme\":{\"command\":\"x\"}}}", "op": "remove", "changed": true,
      "after": { "mcpServers": {} }, "mcpServers": [] },
    { "name": "Disconnect without Saqme there changes nothing", "before": "{\"mcpServers\":{\"files\":{\"command\":\"npx\"}}}", "op": "remove", "changed": false, "after": null, "mcpServers": ["files"] },
    { "name": "Disconnect without a file changes nothing (and makes none)", "before": null, "op": "remove", "changed": false, "after": null, "mcpServers": [] },
    { "name": "Disconnect of a file that is not plain JSON: left alone", "before": "{ \"mcpServers\": { \"saqme\": {} }, }", "op": "remove", "error": true },
    { "name": "state: connected", "before": "{\"mcpServers\":{\"saqme\":{\"command\":\"/opt/saqme/bin/saqme\",\"args\":[\"mcp\",\"--data\",\"/home/nuca/Saqme lists\"]}}}", "op": "state", "state": "connected" },
    { "name": "state: another saqme entry", "before": "{\"mcpServers\":{\"saqme\":{\"command\":\"npx\"}}}", "op": "state", "state": "other" },
    { "name": "state: none (no file)", "before": null, "op": "state", "state": "none" },
    { "name": "state: none (other servers only)", "before": "{\"mcpServers\":{\"files\":{\"command\":\"npx\"}}}", "op": "state", "state": "none" },
    { "name": "state of a file that is not plain JSON", "before": "{,}", "op": "state", "error": true }
  ]
}
